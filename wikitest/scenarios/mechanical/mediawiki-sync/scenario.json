      "expect": {
        "exit_code": 0,
        "stdout": [
          {"kind": "json_pointer_equals", "pointer": "/report/success", "value": true},
          {"kind": "json_pointer_equals", "pointer": "/report/created", "value": 1},
          {"kind": "json_pointer_equals", "pointer": "/report/updated", "value": 1}
