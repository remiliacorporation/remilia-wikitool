{
  "schema": "wikitest.scenario.v4",
  "id": "mechanical-mediawiki-sync",
  "title": "Revision-bound MediaWiki synchronization",
  "description": "Exercises pull, redirects, local diff, exact preview-bound push and delete plans, authenticated one-shot writes, durable mutation reconciliation, and evidence-preserving operator closure through Wikitool's public HTTP boundary.",
  "kind": "mechanical",
  "environment": "isolated",
  "timeout_ms": 120000,
  "coverage": [
    {"capability": "mediawiki-http", "steps": ["pull-templates", "assert-authenticated-one-shot-wire-contract"]},
    {"capability": "pull", "steps": ["pull-templates"]},
    {"capability": "redirects", "steps": ["pull-templates"]},
    {"capability": "diff", "steps": ["diff-local-changes"]},
    {"capability": "remote-conflicts", "steps": ["detect-stale-revision"]},
    {"capability": "push", "steps": ["apply-force-revision-bound-push", "assert-authenticated-one-shot-wire-contract"]},
    {"capability": "push-plan-binding", "steps": ["preview-force-revision-bound-push", "apply-force-revision-bound-push", "preview-force-ambiguous-one-shot-push", "apply-force-ambiguous-one-shot-push"]},
    {"capability": "baserevid", "steps": ["assert-authenticated-one-shot-wire-contract"]},
    {"capability": "createonly", "steps": ["assert-authenticated-one-shot-wire-contract"]},
    {"capability": "no-write-retry", "steps": ["apply-force-ambiguous-one-shot-push", "apply-ambiguous-reconciled-delete", "apply-ambiguous-irreconcilable-delete", "assert-authenticated-one-shot-wire-contract"]},
    {"capability": "delete", "steps": ["apply-standalone-delete", "apply-missingtitle-delete", "apply-post-pull-delete", "assert-authenticated-one-shot-wire-contract"]},
    {"capability": "delete-plan-binding", "steps": ["preview-standalone-delete", "apply-standalone-delete", "preview-ambiguous-reconciled-delete", "apply-ambiguous-reconciled-delete", "preview-ambiguous-irreconcilable-delete", "apply-ambiguous-irreconcilable-delete", "preview-post-pull-delete", "apply-post-pull-delete"]},
    {"capability": "delete-missingtitle", "steps": ["preview-missingtitle-delete", "apply-missingtitle-delete", "assert-authenticated-one-shot-wire-contract"]},
    {"capability": "delete-log-lineage", "steps": ["reconcile-ambiguous-delete-from-visible-marker", "reconcile-irreconcilable-delete", "assert-authenticated-one-shot-wire-contract"]},
    {"capability": "mutation-reconciliation", "steps": ["show-ambiguous-delete", "reconcile-ambiguous-delete-from-visible-marker", "show-reconciled-delete"]},
    {"capability": "mutation-operator-closure", "steps": ["reconcile-irreconcilable-delete", "close-irreconcilable-delete", "show-closed-delete", "list-closed-delete", "reject-write-before-refresh", "refresh-after-operator-closure", "apply-post-pull-delete"]}
  ],
  "mediawiki_fixture": {
    "source": "fixtures/mediawiki.json",
    "sha256": "2c52a768db9b953bc8b1a99f6bbf979d62add1872bf02dead366d14551bd16d0"
  },
  "steps": [
    {
      "action": "command",
      "id": "initialize-project",
      "argv": [
        "init",
        "--templates",
        "--no-network",
        "--wiki-url",
        "http://127.0.0.1",
        "--api-url",
        "{MEDIAWIKI_API_URL}"
      ],
      "expect": {
        "exit_code": 0,
        "files": [
          {"kind": "contains", "path": ".wikitool/config.toml", "value": "127.0.0.1"}
        ]
      }
    },
    {
      "action": "command",
      "id": "pull-templates",
      "argv": ["pull", "--full", "--all", "--format", "json"],
      "expect": {
        "exit_code": 0,
        "stdout": [
          {"kind": "json_pointer_equals", "pointer": "/report/success", "value": true},
          {"kind": "json_pointer_u64_at_least", "pointer": "/report/pulled", "value": 3}
        ],
        "files": [
          {"kind": "contains", "path": "templates/misc/Template_Infobox_existing.wiki", "value": "Existing fixture v1"},
          {"kind": "contains", "path": "templates/misc/_redirects/Template_Infobox_alias.wiki", "value": "#REDIRECT"}
        ]
      }
    },
    {
      "action": "copy",
      "id": "modify-existing-template",
      "source": "fixtures/existing-updated.wiki",
      "target": "templates/misc/Template_Infobox_existing.wiki",
      "sha256": "0067aaac3727d84a0c9b3bc181580c99e8412ef622f7a7df76d7483a181ecced"
    },
    {
      "action": "copy",
      "id": "add-new-template",
      "source": "fixtures/created.wiki",
      "target": "templates/misc/Template_Infobox_created.wiki",
      "sha256": "18a862c0c2367b061e37ba23e4ec1ccae293a3e93f14559cd6263cbece488cbf"
    },
    {
      "action": "command",
      "id": "diff-local-changes",
      "argv": ["diff", "--templates", "--format", "json"],
      "expect": {
        "exit_code": 0,
        "stdout": [
          {"kind": "json_array_item_pointer_equals", "pointer": "/changes", "item_pointer": "/title", "value": "Template:Infobox existing"},
          {"kind": "json_array_item_pointer_equals", "pointer": "/changes", "item_pointer": "/title", "value": "Template:Infobox created"}
        ]
      }
    },
    {
      "action": "mediawiki_update",
      "id": "advance-remote-revision",
      "page": {
        "title": "Template:Infobox existing",
        "namespace": 10,
        "page_id": 10,
        "revision_id": 102,
        "timestamp": "2026-08-27T11:00:00Z",
        "content": "<includeonly>Concurrent remote edit</includeonly>\n"
      }
    },
    {
      "action": "command",
      "id": "detect-stale-revision",
      "argv": ["push", "--all", "--templates", "--summary", "Wikitest preview", "--format", "json"],
      "expect": {
        "exit_code": 1,
        "stdout": [
          {"kind": "json_pointer_equals", "pointer": "/report/success", "value": false},
          {"kind": "json_array_contains", "pointer": "/report/conflicts", "value": "Template:Infobox existing"},
          {"kind": "json_array_item_pointer_equals", "pointer": "/report/pages", "item_pointer": "/action", "value": "would_create"}
        ]
      }
    },
    {
      "action": "command",
      "id": "preview-force-revision-bound-push",
      "argv": ["push", "--force", "--all", "--templates", "--summary", "Wikitest revision-bound push", "--format", "json"],
